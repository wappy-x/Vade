+fn runs_of_separators_become_one_dash() {
+    assert_eq!(slugify("a  --  b!!c"), "a-b-c");
+}
+
+#[test]
+fn leading_separators_are_dropped() {
+    assert_eq!(slugify("  ...Rust"), "rust");
+}
+
+#[test]
+fn digits_stay() {
+    assert_eq!(slugify("Rust 2026"), "rust-2026");
