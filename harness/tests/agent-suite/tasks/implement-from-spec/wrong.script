 pub fn parse_duration(text: &str) -> Result<u64, DurationError> {
-    let _ = text;
-    todo!("implement parse_duration as SPEC.md describes")
+    if text.is_empty() {
+        return Err(DurationError::Empty);
+    }
+    let (mut total, mut digits) = (0u64, String::new());
+    for c in text.chars() {
+        if c.is_ascii_digit() {
+            digits.push(c);
+            continue;
+        }
+        let unit = match c {
+            'd' => 86_400,
+            'h' => 3_600,
+            'm' => 60,
+            's' => 1,
+            _ => return Err(DurationError::Invalid),
+        };
+        let n: u64 = digits.parse().map_err(|_| DurationError::Invalid)?;
+        digits.clear();
+        total = n.checked_mul(unit).and_then(|v| total.checked_add(v)).ok_or(DurationError::Overflow)?;
+    }
+    if !digits.is_empty() {
+        return Err(DurationError::Invalid);
+    }
+    Ok(total)
 }
