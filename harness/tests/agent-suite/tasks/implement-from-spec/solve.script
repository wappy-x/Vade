 pub fn parse_duration(text: &str) -> Result<u64, DurationError> {
-    let _ = text;
-    todo!("implement parse_duration as SPEC.md describes")
+    if text.is_empty() {
+        return Err(DurationError::Empty);
+    }
+    const UNITS: [(u8, u64); 4] = [(b'd', 86_400), (b'h', 3_600), (b'm', 60), (b's', 1)];
+    let bytes = text.as_bytes();
+    let (mut i, mut next, mut total, mut overflow) = (0, 0, 0u64, false);
+    while i < bytes.len() {
+        let start = i;
+        while i < bytes.len() && bytes[i].is_ascii_digit() {
+            i += 1;
+        }
+        if i == start || i == bytes.len() {
+            return Err(DurationError::Invalid);
+        }
+        let found = UNITS[next..].iter().position(|(c, _)| *c == bytes[i]).ok_or(DurationError::Invalid)?;
+        let seconds = UNITS[next + found].1;
+        next += found + 1;
+        let value = text[start..i].parse::<u64>().ok();
+        i += 1;
+        match value.and_then(|v| v.checked_mul(seconds)).and_then(|v| total.checked_add(v)) {
+            Some(sum) => total = sum,
+            None => overflow = true,
+        }
+    }
+    if overflow {
+        Err(DurationError::Overflow)
+    } else {
+        Ok(total)
+    }
 }
