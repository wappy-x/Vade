+use duration::{parse_duration, DurationError};
+
+#[test]
+fn spec_examples() {
+    assert_eq!(parse_duration("45s"), Ok(45));
+    assert_eq!(parse_duration("1h30m"), Ok(5400));
+    assert_eq!(parse_duration("2d3s"), Ok(172_803));
+    assert_eq!(parse_duration("90m"), Ok(5400));
+    assert_eq!(parse_duration("1m1h"), Err(DurationError::Invalid));
+    assert_eq!(parse_duration("5"), Err(DurationError::Invalid));
+    assert_eq!(parse_duration(" 5s"), Err(DurationError::Invalid));
+    assert_eq!(parse_duration(""), Err(DurationError::Empty));
