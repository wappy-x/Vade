#!/bin/sh
# A fake rsync: see README.txt. It copies into the folder of --rsync-path.
[ "${1-}" != --version ] || { echo 'rsync fake'; exit 0; }
receiver=
while [ $# -gt 0 ]; do
    case $1 in
        -e) shift 2 ;;
        --rsync-path=*) receiver=${1#--rsync-path=}; shift ;;
        -*) shift ;;
        *) break ;;
    esac
done
for last in "$@"; do :; done
host=${last%:./}
home=$FAKE_HOSTS/$host
# One write per call: two hosts copy at the same time.
[ -f "$home/known" ] || { printf 'rsync %s
' "$host" >> "$FAKE_HOSTS/calls.log"; echo 'Host key verification failed.' >&2; exit 255; }
[ ! -f "$home/denied" ] || { printf 'rsync %s
' "$host" >> "$FAKE_HOSTS/calls.log"; echo "fake@$host: Permission denied (publickey)." >&2; exit 255; }
folder=${receiver#umask 077 && cd }
folder=${folder% && exec rsync}
folder=$(HOME=$home; eval "cd $folder" && pwd -P) || { printf 'rsync %s\n' "$host" >> "$FAKE_HOSTS/calls.log"; exit 12; }
row="rsync $host"
while [ $# -gt 1 ]; do
    row="$row $(basename -- "$1")"
    cp "$1" "$folder/"
    [ ! -f "$home/corrupt" ] || printf 'changed' >> "$folder/$(basename -- "$1")"
    shift
done
printf '%s\n' "$row" >> "$FAKE_HOSTS/calls.log"
