{
  "model_type": "glm5_next",
  "text_config": {
    "model_type": "glm5_next_text",
    "hidden_size": 128,
    "num_hidden_layers": 2,
    "num_nextn_predict_layers": 1,
    "layer_types": ["linear_attention", "deepseek_sparse_attention"],
    "mlp_layer_types": ["dense", "sparse"],
    "first_k_dense_replace": 1,
    "moe_intermediate_size": 64,
    "n_shared_experts": 2
  },
  "vision_config": {"model_type": "glm5_next_vision"},
  "quantization_config": {
    "quant_method": "modelopt",
    "quant_algo": "MIXED_PRECISION",
    "exclude_modules": ["model.language_model.layers.0.self_attn.q_proj"],
    "quantized_layers": {
      "lm_head": {"quant_algo": "MXFP8", "weight_block_size": [1, 32]},
      "model.language_model.layers.0.self_attn.q_proj": {"quant_algo": "MXFP8", "weight_block_size": [1, 32]},
      "model.language_model.layers.1.mlp.experts": {"quant_algo": "NVFP4", "group_size": 16, "weight_scale_encoding": "csf_32x2_v1"},
      "model.language_model.layers.1.mlp.shared_experts.gate_proj": {"quant_algo": "FP8_PB_WO", "weight_block_size": [128, 128]},
      "model.language_model.layers.1.mlp.shared_experts.up_proj": {"quant_algo": "MXFP8", "weight_block_size": [1, 32]},
      "model.language_model.layers.1.mlp.shared_experts.down_proj": {"quant_algo": "FP8_PB_WO", "weight_block_size": [128, 128]},
      "model.language_model.layers.2.mlp.experts": {"quant_algo": "W4A16_NVFP4", "group_size": 16}
    }
  }
}
